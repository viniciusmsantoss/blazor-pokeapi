@page "/"
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@inject HttpClient Http

<PageTitle>Buscar Pokémon</PageTitle>

<h1>Buscar Pokémon</h1>

<div class="mb-3" style="max-width: 400px;">
    <label class="form-label">Nome do Pokémon:</label>
    <input type="text" class="form-control mb-2" @bind="nomePokemon" placeholder="ex: pikachu" />
    <button class="btn btn-primary" @onclick="BuscarPokemon">Buscar Pokémon</button>
</div>

@if (carregando)
{
    <p><em>A carregar dados do Pokémon...</em></p>
}

@if (erro != null)
{
    <p class="text-danger">@erro</p>
}

@if (pokemon != null && !carregando && erro == null)
{
    <hr />
    <h3>Detalhes do Pokémon</h3>

    @if (pokemon.Sprites?.Other?.OfficialArtwork?.FrontDefault != null)
    {
        <img src="@pokemon.Sprites.Other.OfficialArtwork.FrontDefault" alt="@pokemon.Name" style="width: 150px; height: 150px;" />
    }

    <p class="mt-2"><strong>ID:</strong> @pokemon.Id</p>
    <p><strong>Nome:</strong> @pokemon.Name</p>
    <p><strong>Altura:</strong> @((pokemon.Height / 10.0).ToString("0.0")) m</p>
    <p><strong>Peso:</strong> @(pokemon.Weight / 10.0) kg</p>
}

@code {
    private string nomePokemon = "pikachu";
    private PokemonResponse? pokemon;
    private bool carregando = false;
    private string? erro;

    private async Task BuscarPokemon()
    {
        if (string.IsNullOrWhiteSpace(nomePokemon)) return;

        carregando = true;
        erro = null;

        try
        {
            string url = $"https://pokeapi.co/api/v2/pokemon/{nomePokemon.ToLower().Trim()}";
            pokemon = await Http.GetFromJsonAsync<PokemonResponse>(url);
        }
        catch (Exception)
        {
            pokemon = null;
            erro = "Pokémon não encontrado. Verifique o nome digitado e tente novamente.";
        }
        finally
        {
            carregando = false;
        }
    }

    public class PokemonResponse
    {
        [JsonPropertyName("id")]
        public int Id { get; set; }

        [JsonPropertyName("name")]
        public string? Name { get; set; }

        [JsonPropertyName("height")]
        public int Height { get; set; }

        [JsonPropertyName("weight")]
        public int Weight { get; set; }

        [JsonPropertyName("sprites")]
        public SpritesData? Sprites { get; set; }
    }

    public class SpritesData
    {
        [JsonPropertyName("other")]
        public OtherSprites? Other { get; set; }
    }

    public class OtherSprites
    {
        [JsonPropertyName("official-artwork")]
        public OfficialArtworkData? OfficialArtwork { get; set; }
    }

    public class OfficialArtworkData
    {
        [JsonPropertyName("front_default")]
        public string? FrontDefault { get; set; }
    }
}